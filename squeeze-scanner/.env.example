# Required: Claude API
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_EFFORT=high
# Server-side refusal fallback (1=on, 0=off)
ANTHROPIC_FALLBACKS=1

# Optional data providers (yfinance is always available, no key needed)
# Alpha Vantage: prices + NEWS_SENTIMENT  -> https://www.alphavantage.co/support/#api-key
ALPHAVANTAGE_API_KEY=
# Twelve Data: prices                     -> https://twelvedata.com/pricing (free tier)
TWELVEDATA_API_KEY=
# Extra news sources
FINNHUB_API_KEY=
POLYGON_API_KEY=
# Price provider fallback order (providers without a key are skipped)
PRICE_PROVIDERS=twelvedata,alphavantage,yfinance

# Optional: custom universe
# SCAN_UNIVERSE=AAPL,MSFT,NVDA

# Rulebook thresholds (defaults shown)
# RULE_COMPRESSION_RATIO_MAX=0.35
# RULE_NEAR_HIGH_MAX_PCT=0.04
# NEWS_RECENT_HOURS=72
# NEWS_RECENT_WEIGHT=0.70
